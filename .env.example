# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — Dashboard → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Subscriptions → Plans → Create Plan (₹499/month) → copy plan id
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxx
# Dashboard → Account & Settings → Webhooks → secret you set while creating the webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# App URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Root domain used for tenant subdomains (e.g. zara.bicres.com)
NEXT_PUBLIC_MAIN_DOMAIN=bicres.com
# Tenant used for localhost / the bare main domain
DEFAULT_SUBDOMAIN=default
